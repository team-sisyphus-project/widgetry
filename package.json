{
  "name": "widgetry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Live UI utilities you can take with you.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:e2e": "vite build --config vite.e2e.config.ts",
    "preview:e2e": "vite preview --config vite.e2e.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
